<!-- deploy/windows/monitor_agent_task.xml -->
<!-- Import via: schtasks /create /xml monitor_agent_task.xml /tn "MonitorAgent" -->
<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <BootTrigger><Enabled>true</Enabled><Delay>PT30S</Delay></BootTrigger>
  </Triggers>
  <Principals>
    <Principal><UserId>S-1-5-18</UserId><RunLevel>HighestAvailable</RunLevel></Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Hidden>false</Hidden>
  </Settings>
  <Actions>
    <Exec>
      <Command>C:\Python311\python.exe</Command>
      <Arguments>C:\ProgramData\Monitor\agent\monitor_agent.py</Arguments>
    </Exec>
  </Actions>
</Task>
